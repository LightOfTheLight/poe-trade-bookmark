{
  "manifest_version": 3,
  "name": "PoE Trade 书签",
  "version": "1.0.0",
  "description": "为 poe.game.qq.com/trade 保存和快速加载交易搜索书签",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://poe.game.qq.com/trade/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "PoE Trade 书签"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://poe.game.qq.com/trade/*"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
